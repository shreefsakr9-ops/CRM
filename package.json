{
  "name": "bluepoint-os",
  "version": "0.1.0",
  "private": true,
  "description": "Blue Point OS — Internal CRM & Business Management System",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "worker": "tsx --conditions=react-server src/worker/index.ts",
    "worker:once": "tsx --conditions=react-server src/worker/run-once.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:setup": "tsx --conditions=react-server tests/setup-db.ts",
    "visual": "tsx --conditions=react-server tests/visual-check.ts"
  },
  "prisma": {
    "seed": "tsx --conditions=react-server prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "^5.3.0",
    "@prisma/client": "6.19.3",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "lucide-react": "0.548.0",
    "next": "15.5.22",
    "papaparse": "5.5.4",
    "playwright-core": "1.62.0",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "react-hook-form": "7.71.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "2.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/papaparse": "5.3.16",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "autoprefixer": "10.4.21",
    "dotenv": "^17.4.2",
    "postcss": "8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20.11"
  }
}