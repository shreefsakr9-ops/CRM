# ─── Blue Point OS — Environment ───────────────────────────────
# انسخ هذا الملف إلى .env واملأ القيم الحقيقية. لا ترفع .env إلى Git إطلاقًا.

# Database
# دور واحد يملك الجداول ويُستخدم للتطبيق والمايجريشن والـWorker معًا.
# RLS غير مفعّلة حاليًا (راجع docs/02-erd.md §5) — لا يوجد دور تطبيق منفصل بعد.
DATABASE_URL="postgresql://bluepoint:CHANGE_ME@localhost:5432/bluepoint?schema=public"

# قاعدة بيانات منفصلة تمامًا للاختبارات (npm test، npm run test:e2e) — تُصفَّر
# بياناتها بين التشغيلات، فلا تُشِر أبدًا إلى قاعدة التطوير أو الإنتاج نفسها.
TEST_DATABASE_URL="postgresql://bluepoint:CHANGE_ME@localhost:5432/bluepoint_test?schema=public"

# Application
NODE_ENV="development"
APP_URL="http://localhost:3000"
PORT=3000

# Secrets — ولّدها بـ: openssl rand -base64 48
SESSION_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_48"
FILE_SIGNING_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_48"

# Sessions
SESSION_IDLE_MINUTES=240
SESSION_ABSOLUTE_HOURS=168

# File storage
STORAGE_DIR="./storage"
MAX_UPLOAD_MB=25

# PDF rendering (Chromium)
# اتركه فارغًا لاستخدام chromium المثبت في الصورة
CHROMIUM_PATH=""

# Email (اختياري — التنبيهات داخل النظام تعمل بدونه)
# اترك SMTP_HOST فارغًا لتعطيل البريد بالكامل: لن يفشل أي إجراء بسببه،
# لكن رسائل إعادة تعيين كلمة المرور والإشعارات والملخصات لن تُرسل.
SMTP_HOST=""
SMTP_PORT=587
# اتركه فارغًا للاستنتاج التلقائي: 465 = TLS ضمني، وغيره = STARTTLS إجباري
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Blue Point OS <no-reply@example.com>"

# Worker
WORKER_INTERVAL_SECONDS=300

# Seed (تُستخدم مرة واحدة عند التهيئة — غيّرها فورًا في الإنتاج)
SEED_ADMIN_EMAIL="admin@bluepoint.local"
SEED_ADMIN_PASSWORD="CHANGE_ME_strong_password"
SEED_DEMO_DATA="true"
